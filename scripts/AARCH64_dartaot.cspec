<?xml version="1.0" encoding="UTF-8"?>

<!-- Dart AOT (ahead-of-time) compiled ARM64 calling convention.

     Key differences from standard AARCH64 ABI:
     - x15: Dart shadow stack pointer (configured as the stack pointer for decompilation, preserved across calls)
     - x26: Thread pointer (THR) - points to Dart Thread struct
     - x27: Object Pool pointer (PP) - points to constant pool
     - x28: Heap base (HEAP) - used for compressed pointer decompression
     - All three (x26/x27/x28) are callee-saved / global
     - Parameters: x0 (receiver/this), x1-x7 (arguments), return in x0
     - No hidden return register (x8 not used for indirect returns)
-->
<compiler_spec>
  <data_organization>
     <absolute_max_alignment value="0" />
     <machine_alignment value="4" />
     <default_alignment value="1" />
     <default_pointer_alignment value="8" />
     <pointer_size value="8" />
     <wchar_size value="4" />
     <short_size value="2" />
     <integer_size value="4" />
     <long_size value="8" />
     <long_long_size value="8" />
     <float_size value="4" />
     <double_size value="8" />
     <long_double_size value="8" />
     <size_alignment_map>
          <entry size="1" alignment="1" />
          <entry size="2" alignment="2" />
          <entry size="4" alignment="4" />
          <entry size="8" alignment="8" />
          <entry size="16" alignment="16"/>
     </size_alignment_map>
  </data_organization>

  <global>
    <range space="ram"/>
  </global>

  <stackpointer register="x15" space="ram"/>
  <funcptr align="4"/>

  <prefersplit style="inhalf">
    <register name="q0"/>
    <register name="q1"/>
    <register name="q2"/>
    <register name="q3"/>
    <register name="q4"/>
    <register name="q5"/>
    <register name="q6"/>
    <register name="q7"/>
  </prefersplit>

  <default_proto>
    <prototype name="DartAOT" extrapop="0" stackshift="0">
      <input>
        <!-- Float/SIMD arguments first (Ghidra requires storage class ordering) -->
        <pentry minsize="1" maxsize="16" storage="float">
          <register name="q0"/>
        </pentry>
        <pentry minsize="1" maxsize="16" storage="float">
          <register name="q1"/>
        </pentry>
        <!-- Dart passes arguments in x0-x7. x0 is typically receiver/this -->
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x0"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x1"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x2"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x3"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x4"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x5"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x6"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x7"/>
        </pentry>
        <!-- Stack overflow for remaining args -->
        <pentry minsize="1" maxsize="500" align="8">
          <addr offset="0" space="stack"/>
        </pentry>
      </input>
      <output>
        <pentry minsize="1" maxsize="16" storage="float">
          <register name="q0"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x0"/>
        </pentry>
        <pentry minsize="1" maxsize="8" extension="zero">
          <register name="x1"/>
        </pentry>
      </output>
      <unaffected>
        <!-- Standard callee-saved -->
        <register name="x19"/>
        <register name="x20"/>
        <register name="x21"/>
        <register name="x22"/>
        <register name="x23"/>
        <register name="x24"/>
        <register name="x25"/>
        <!-- Dart runtime globals - preserved across ALL calls -->
        <register name="x15"/>  <!-- Dart shadow stack pointer -->
        <register name="x26"/>  <!-- THR: Thread pointer -->
        <register name="x27"/>  <!-- PP: Object Pool pointer -->
        <register name="x28"/>  <!-- HEAP: Heap base for compressed pointers -->
        <!-- Frame/stack -->
        <register name="x29"/>  <!-- FP -->
        <register name="x30"/>  <!-- LR -->
        <register name="sp"/>
        <!-- SIMD callee-saved -->
        <register name="d8"/>
        <register name="d9"/>
        <register name="d10"/>
        <register name="d11"/>
        <register name="d12"/>
        <register name="d13"/>
        <register name="d14"/>
        <register name="d15"/>
      </unaffected>
      <killedbycall>
        <register name="x0"/>
        <register name="x1"/>
        <register name="x8"/>
        <register name="x9"/>
        <register name="x10"/>
        <register name="x11"/>
        <register name="x12"/>
        <register name="x13"/>
        <register name="x14"/>
        <!-- x15 NOT killed - it's Dart's shadow stack pointer -->
        <register name="x16"/>
        <register name="x17"/>
        <register name="x18"/>
        <register name="q0"/>
        <!-- SIMD caller-saved -->
        <register name="d16"/>
        <register name="d17"/>
        <register name="d18"/>
        <register name="d19"/>
        <register name="d20"/>
        <register name="d21"/>
        <register name="d22"/>
        <register name="d23"/>
        <register name="d24"/>
        <register name="d25"/>
        <register name="d26"/>
        <register name="d27"/>
        <register name="d28"/>
        <register name="d29"/>
        <register name="d30"/>
        <register name="d31"/>
      </killedbycall>
    </prototype>
  </default_proto>

  <!-- Stub calling convention: most stubs preserve all general registers -->
  <prototype name="DartStub" extrapop="0" stackshift="0">
    <input>
      <pentry minsize="1" maxsize="8">
        <register name="x0"/>
      </pentry>
    </input>
    <output>
      <pentry minsize="1" maxsize="8">
        <register name="x0"/>
      </pentry>
    </output>
    <unaffected>
      <register name="x0"/>
      <register name="x1"/>
      <register name="x2"/>
      <register name="x3"/>
      <register name="x4"/>
      <register name="x5"/>
      <register name="x6"/>
      <register name="x7"/>
      <register name="x15"/>
      <register name="x19"/>
      <register name="x20"/>
      <register name="x21"/>
      <register name="x22"/>
      <register name="x23"/>
      <register name="x24"/>
      <register name="x25"/>
      <register name="x26"/>
      <register name="x27"/>
      <register name="x28"/>
      <register name="x29"/>
      <register name="x30"/>
      <register name="sp"/>
    </unaffected>
  </prototype>

  <!-- Placeholder callfixup to force callfixup processing -->
  <callfixup name="PlaceHolderCallFixup">
    <target name="___NotARealFunctionName___"/>
    <pcode>
      <body><![CDATA[
            tmpptr:4 = 0;
      ]]></body>
    </pcode>
  </callfixup>

  <!-- Stack overflow check stub - preserves everything -->
  <callfixup name="StackOverflowCheck">
    <target name="StackOverflowSharedWithoutFPURegsStub"/>
    <pcode>
      <body><![CDATA[
            tmpptr:4 = 0;
      ]]></body>
    </pcode>
  </callfixup>

</compiler_spec>
